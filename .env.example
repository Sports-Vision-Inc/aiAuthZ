# aiAuthZ configuration. Copy to .env (or .env.local) and edit.
# Every value is also available as an environment variable with the same name.

# Deployment mode: dev | self_hosted | hosted.
# Affects defaults only; concrete behavior is driven by the variables below.
AIAUTHZ_MODE=dev

# --- Datastore -----------------------------------------------------------------

# SQLAlchemy URL. Defaults to SQLite in ./data for local development.
# For Postgres:
#   AIAUTHZ_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/aiauthz
AIAUTHZ_DATABASE_URL=sqlite:///./data/aiauthz.db

# Redis URL. Leave empty to use an in-process fakeredis (development only).
# Required in production.
AIAUTHZ_REDIS_URL=

# --- Cryptography --------------------------------------------------------------

# Master key used for envelope encryption of HMAC keys, message bodies, and
# tool arguments at rest. Must be a 32-byte url-safe base64 value.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIAUTHZ_MASTER_KEY=replace-me-with-a-real-32-byte-urlsafe-base64-key=

# HMAC replay window in seconds. Nonces are cached for this long; messages
# whose timestamp falls outside the window are rejected.
AIAUTHZ_NONCE_TTL_SECONDS=300

# --- Watermarking --------------------------------------------------------------

# Audit watermark for accepted messages. Stores a QR-coded artifact (no
# plaintext) under AIAUTHZ_WATERMARK_DIR.
AIAUTHZ_WATERMARK_ENABLED=true
# Where to store watermark artifacts: db (default) | file
# In db mode the PNG is encrypted with the master key and held alongside
# the message row. In file mode the PNG is written under WATERMARK_DIR
# (mount a persistent volume here in production).
AIAUTHZ_WATERMARK_STORE=db
AIAUTHZ_WATERMARK_DIR=./storage/watermarks

# --- Tool gateway --------------------------------------------------------------

# Path to the YAML mapping each tool to an executor (decision | forward |
# python:dotted:path). When unset the gateway uses the built-in defaults
# (every tool resolves to `decision`, which never produces a side effect).
AIAUTHZ_TOOLS_CONFIG=

# --- Server --------------------------------------------------------------------

AIAUTHZ_HOST=127.0.0.1
AIAUTHZ_PORT=8080

# --- Validators (optional) -----------------------------------------------------
# Required only when running scripts/anthropic_validator.py against the live
# Anthropic API. The validator never executes any tool; it observes which
# tool the model attempts and asks aiAuthZ for an allow/deny decision.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

